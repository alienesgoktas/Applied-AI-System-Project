        SCORE["score_song()<br/>genre + mood + energy<br/>+ valence + acoustic<br/>→ (score, reasons)"]
        RANK["recommend_songs() / Recommender.recommend()<br/>sort by score desc · tie-break by id · take top-k"]
    end

    subgraph Interfaces["Interfaces"]
        CLI["src/main.py<br/>CLI runner · explained output"]
        TESTS["tests/test_recommender.py<br/>pytest suite"]
    end

    CSV --> LOAD --> SCORE
    USER --> SCORE
    STRAT -. injected weights .-> SCORE
