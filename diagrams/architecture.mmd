flowchart TB
    USER(["User taste profile<br/>genre · mood · target energy<br/>target valence · likes acoustic"])
    OUT(["Top-k recommendations<br/>ranked, each with a plain-language 'why'"])

    subgraph Data["Data layer"]
        CSV[("data/songs.csv<br/>20-song catalog")]
    end

